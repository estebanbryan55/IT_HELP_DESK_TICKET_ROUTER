APP_NAME="IT Help Desk Ticket Router"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Help Desk Ticket Router: Week 14 security settings ---
# Reject plain-HTTP API calls. Set false ONLY for local development.
REQUIRE_HTTPS=true
HSTS_MAX_AGE=31536000
TRUSTED_PROXIES=127.0.0.1
# Flutter Web origin(s) allowed by CORS, comma-separated
FRONTEND_ORIGINS=http://localhost:5000
# Bearer token lifetime (minutes)
API_TOKEN_TTL_MINUTES=60
SANCTUM_TOKEN_PREFIX=hdr_
# Email-gateway HMAC keys: keyId:secret[,keyId2:secret2]. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
INTEGRATION_HMAC_KEYS=
INTEGRATION_SIGNATURE_TOLERANCE=300
# Used only by "php artisan gateway:send" (the gateway simulator)
GATEWAY_KEY_ID=
GATEWAY_URL=https://localhost:8443/api/v1/integrations/email-gateway/tickets
