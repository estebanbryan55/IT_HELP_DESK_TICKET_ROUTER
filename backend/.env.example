# Copy this file to .env and change the values. Never commit .env.
# All values below are non-secret placeholders for the controlled test environment.

APP_ENV=development
HOST=127.0.0.1
PORT=8080

# Local JSON data store and structured log file (both git-ignored)
DATA_FILE=data/store.json
LOG_FILE=logs/app.log
RULES_FILE=config/routing_rules.json

# Flutter Web dev server origins allowed by CORS (comma separated, * = any port)
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Week 13 demo identity header (X-Demo-User). Replaced by real authentication in Week 14.
DEMO_AUTH_ENABLED=true

# Notification gateway (mock service in bin/mock_gateway.dart)
GATEWAY_URL=http://127.0.0.1:8091
GATEWAY_API_KEY=change-me-local-only
GATEWAY_TIMEOUT_MS=3000
MOCK_GATEWAY_PORT=8091

# Retry policy for notifications
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=2000
RETRY_MAX_DELAY_MS=30000

# Scheduler intervals
OUTBOX_POLL_SECONDS=5
AGING_SCAN_SECONDS=60
SUMMARY_CHECK_SECONDS=60
SUMMARY_HOUR=18
TIMEZONE_OFFSET_HOURS=8

# SLA targets in hours per priority, and the warning threshold (fraction of SLA used)
SLA_HOURS_CRITICAL=4
SLA_HOURS_HIGH=8
SLA_HOURS_MEDIUM=24
SLA_HOURS_LOW=72
SLA_WARNING_RATIO=0.75
