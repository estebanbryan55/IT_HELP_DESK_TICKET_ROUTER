# Copy this file to .env, then run: php artisan key:generate
# All values below are non-secret placeholders for the controlled test environment. Never commit .env.

APP_NAME="Help Desk Ticket Router"
APP_ENV=development
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=UTC

# MySQL / MariaDB (XAMPP default: root with no password)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helpdesk
DB_USERNAME=root
DB_PASSWORD=

# Stateless JSON API: no sessions or cookies
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=info

# Structured JSON-lines log and routing rules (relative to the project root)
HELPDESK_LOG_FILE=storage/logs/app.log
RULES_FILE=config/routing_rules.json

# Flutter Web dev server origins allowed by CORS (comma separated, * = any port)
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Week 13 demo identity header (X-Demo-User). Replaced by real authentication in Week 14.
DEMO_AUTH_ENABLED=true

# Notification gateway (mock service in gateway/mock_gateway.php)
GATEWAY_URL=http://127.0.0.1:8091
GATEWAY_API_KEY=change-me-local-only
GATEWAY_TIMEOUT_MS=3000
MOCK_GATEWAY_PORT=8091

# Retry policy for notifications
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=2000
RETRY_MAX_DELAY_MS=30000

# Scheduler (php artisan schedule:work)
OUTBOX_POLL_SECONDS=5
SUMMARY_HOUR=18
TIMEZONE_OFFSET_HOURS=8

# SLA targets in hours per priority, and the warning threshold (fraction of SLA used)
SLA_HOURS_CRITICAL=4
SLA_HOURS_HIGH=8
SLA_HOURS_MEDIUM=24
SLA_HOURS_LOW=72
SLA_WARNING_RATIO=0.75
